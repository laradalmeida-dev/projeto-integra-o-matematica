{
    "name": "projeto/integra-o-matematica",
    "description": "Aplicação web em PHP para Álgebra Linear e Testes Unitários",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "ProjetoIntegraOMatematica\\Controller\\": "Controller/",
            "ProjetoIntegraOMatematica\\View\\": "View/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ProjetoIntegraOMatematica\\Test\\": "Test/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}